# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet is hosted (without callback path).
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# FYERS_APP_ID: Your Fyers API v3 App ID (e.g. XXXXXXXXXX-100) from https://myapi.fyers.in/dashboard
# Configure the real value in AI Studio Secrets (do not put secrets in .env.example).
FYERS_APP_ID="MY_FYERS_APP_ID"

# FYERS_SECRET_ID: Your Fyers API v3 Secret Key from https://myapi.fyers.in/dashboard
# Configure the real value in AI Studio Secrets (do not put secrets in .env.example).
FYERS_SECRET_ID="MY_FYERS_SECRET_ID"

# FYERS_PIN (Optional): Your 4-digit Fyers login PIN.
# If set in AI Studio Secrets, NeoAlgo automatically renews your expired daily access token
# using Fyers' 15-day refresh_token so your connection stays active until you click Disconnect.
FYERS_PIN="MY_FYERS_PIN"

# SESSION_SECRET (Recommended for AWS VPS): 32+ character random secret for encrypting
# stored per-user broker tokens and signing user sessions on disk.
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# DATA_DIR (Optional for AWS VPS): Absolute or relative path for persistent user accounts,
# paper trade journals, and encrypted broker connections (defaults to ./data).
DATA_DIR="./data"

